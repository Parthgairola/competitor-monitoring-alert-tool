      "id": "3ad54053-eb42-45e9-84c8-1a36fe0727f5",
      "name": "Get last pricing",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        112,
        -512
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const domain = $('On form submission').first().json.domain;\nconst html = String($('Get pricing page').first().json.data || '');\nconst oldPrices = $('Get last pricing').first().json.prices || '';\n\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ');\n\n// find each price plus the few words just before it\nconst re = /\\$\\s?\\d[\\d,]*(?:\\.\\d+)?/g;\nconst ctx = {};\nlet m;\nwhile ((m = re.exec(text)) !== null) {\n  const p = m[0].replace(/\\s/g, '');\n  if (p === '$0' || p in ctx) continue;\n  ctx[p] = text.slice(Math.max(0, m.index - 60), m.index)\n    .replace(/\\s+/g, ' ').trim().split(' ').slice(-4).join(' ');\n}\nconst prices = Object.keys(ctx).slice(0, 30).join(' | ');\n\nconst oldList = oldPrices ? oldPrices.split(' | ') : [];\nconst newList = prices ? prices.split(' | ') : [];\nconst added = newList.filter(p => !oldList.includes(p));\nconst removed = oldList.filter(p => !newList.includes(p));\n\nlet status = 'unchanged';\nif (!prices) status = 'unavailable';\nelse if (!oldPrices) status = 'first_check';\nelse if (added.length || removed.length) status = 'changed';\n\nconst messages = {\n  changed: [\n    `${domain}: pricing changed`,\n    `Pricing changed on ${domain}/pricing\\n\\n` +\n    `New: ${added.map(p => ctx[p] ? `${p} (near: \"${ctx[p]}\")` : p).join(', ') || 'none'}\\n` +\n    `Removed: ${removed.join(', ') || 'none'}\\n\\n` +\n    `All prices now: ${prices}`\n  ],\n  first_check: [`${domain}: pricing baseline saved`, `Saved the first pricing snapshot for ${domain}: ${prices}`],\n  unchanged:   [`${domain}: no pricing changes`, `No pricing changes detected on ${domain}/pricing.`],\n  unavailable: [`${domain}: pricing unavailable`, `Could not read prices on ${domain}/pricing. The page may not exist, may block scrapers, or may load prices with JavaScript.`]\n};\n\nreturn [{ json: {\n  domain,\n  prices: status === 'unavailable' ? oldPrices : prices,\n  status,\n  subject: messages[status][0],\n  text: messages[status][1]\n}}];"
      },
