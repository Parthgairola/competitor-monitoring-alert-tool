      "id": "250a837f-5412-4b16-8d95-bebb54821f67",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -512,
        -208
      ],
      "webhookId": "14ea0162-d5b2-4aea-8e22-bb9f727d8efd"
    },
    {
      "parameters": {
        "jsCode": "const xml = String($input.first().json.data || '');\nconst domain = $('On form submission').first().json.domain;\nconst headers = { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0 Safari/537.36' };\nconst base = `https://${domain}`;\nconst debug = [];\nconst e0 = $input.first().json.error;\nif (e0) debug.push('sitemap -> ' + String(e0.message || e0).slice(0, 80));\n\nconst get = async (url) => {\n  try { return String(await this.helpers.httpRequest({ url, headers })); }\n  catch (e) { debug.push(url + ' -> ' + String(e.message).slice(0, 80)); return ''; }\n};\nconst getLocs = (x) =>\n  [...x.matchAll(/<loc>\\s*(?:<!\\[CDATA\\[)?\\s*(.*?)\\s*(?:\\]\\]>)?\\s*<\\/loc>/g)].map(m => m[1]);\nconst isPost = (u) =>\n  /\\/(blog|blogs|post|posts|article|articles|learn|news|resources)\\/[^/?#]+-[^/?#]+/i.test(u) &&\n  !/\\/(tag|tags|category|author|page)\\//i.test(u);\n\nlet posts = [];\n\n// Method 1: sitemap\nlet urls = getLocs(xml);\nif (urls.some(u => u.includes('.xml'))) {\n  const subs = urls.filter(u => u.includes('.xml') && /blog|post|article|news/i.test(u)).slice(0, 3);\n  urls = urls.filter(u => !u.includes('.xml'));\n  for (const s of subs) urls.push(...getLocs(await get(s)));\n}\nposts = urls.filter(isPost);\n\n// Method 2: links on the blog page\nif (posts.length < 3) {\n  const html = await get(`${base}/blog`);\n  const links = [...html.matchAll(/href=\"([^\"#]+)\"/g)]\n    .map(m => { try { return new URL(m[1], base).href; } catch (e) { return null; } })\n    .filter(u => u && u.includes(domain) && isPost(u));\n  posts.push(...links);\n}\n\n// Method 3: RSS feed\nif (posts.length < 3) {\n  const feeds = ['/feed', '/feed.xml', '/rss.xml', '/rss', '/blog/feed', '/blog/rss.xml', '/blog/feed.xml', '/blog/feeder/'];\n  for (const f of feeds) {\n    const text = await get(base + f);\n    if (!/<item>|<entry>/.test(text)) continue;\n    const blocks = [...text.matchAll(/<item>([\\s\\S]*?)<\\/item>|<entry>([\\s\\S]*?)<\\/entry>/g)].map(m => m[1] || m[2]);\n    const links = blocks.map(b =>\n      (b.match(/<link>\\s*(?:<!\\[CDATA\\[)?\\s*(https?:[^<\\s\\]]+)/) || b.match(/<link[^>]+href=\"([^\"]+)\"/) || [])[1]\n    ).filter(Boolean);\n    if (links.length) { posts.push(...links); break; }\n  }\n}\n\nposts = [...new Set(posts)].slice(0, 15);\n\nif (posts.length === 0) {\n  return [{ json: { error: 'NO_POSTS_FOUND', domain, sitemapUrls: urls.length, debug: debug.join(' | ') } }];\n}\nreturn posts.map(u => ({ json: { url: u, domain } }));"
      },
      "id": "65334be5-f437-45b7-b3cd-5ffd36a518e3",
      "name": "Get post URLs",
