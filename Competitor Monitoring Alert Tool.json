    {
      "parameters": {
        "jsCode": "const clean = t => {\n  let k = String(t || '').split('|')[0]\n    .replace(/\\[?\\b20\\d\\d\\b\\]?/g, '')\n    .replace(/[?:!,.()]/g, ' ')\n    .toLowerCase()\n    .replace(/^(the|a|an)\\s+/, '')\n    .replace(/^\\d+\\s+/, '')\n    .replace(/^the\\s+/, '')\n    .trim();\n  let words = k.split(/\\s+/).slice(0, 5);\n  while (words.length > 2 && /^(in|for|on|of|to|and|vs|with|a|the|is|are|which)$/.test(words[words.length - 1])) words.pop();\n  return words.join(' ');\n};\n\nconst posts = $('Keep only new').all().map(i => ({ ...i.json, keyword: clean(i.json.title) }));\nreturn [{ json: { posts } }];"
      },
      "id": "5fb8ae6b-c5a2-4c05-865d-0d508c1a82ae",
      "name": "Make Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2336,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const posts = $('Make Keywords').first().json.posts;\nconst domain = posts[0].domain;\n\nconst vol = {};\nlet anyVolume = false;\ntry {\n  for (const r of $('Get search volume').all()) {\n    const j = r.json;\n    if (!j.keyword) continue;\n    let text = null;\n    if (j.estimatedMonthlySearches != null) {\n      text = `~${j.estimatedMonthlySearches}/month (est.)`;\n    } else if (j.estimatedRange && j.estimatedRange.high) {\n      text = `~${j.estimatedRange.low}-${j.estimatedRange.high}/month (est.)`;\n    }\n    if (text) { vol[String(j.keyword).toLowerCase()] = text; anyVolume = true; }\n  }\n} catch (e) {}\n\nconst lines = posts.map((p, i) => {\n  const v = vol[p.keyword.toLowerCase()];\n  return `${i + 1}. ${p.title}\\n${p.url}\\nKeyword: ${p.keyword}` + (v ? ` | Est. volume: ${v}` : '');\n});\n\nconst note = anyVolume\n  ? ''\n  : '\\n\\n(Search volume estimates were unavailable for this run.)';\n\nreturn [{ json: {\n  subject: `${domain}: ${posts.length} new posts`,\n  text: `${domain} published ${posts.length} new post(s):\\n\\n` + lines.join('\\n\\n') + note\n}}];"
      },
