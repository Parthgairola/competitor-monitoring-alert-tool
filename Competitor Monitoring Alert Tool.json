    {
      "parameters": {
        "jsCode": "const txt = (v) => {\n  if (Array.isArray(v)) v = v[0];\n  if (v && typeof v === 'object') v = v.content ?? v.value ?? '';\n  return String(v ?? '').trim();\n};\n\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const ldDate = (String(txt(j.ld)).match(/\"datePublished\"\\s*:\\s*\"([^\"]+)\"/) || [])[1];\n  return {\n    json: {\n      title: txt(j.title),\n      description: txt(j.description),\n      date: txt(j.date) || txt(j.date2) || ldDate || '',\n      url: $('Get post URLs').all()[item.pairedItem.item].json.url,\n      domain: $('On form submission').first().json.domain,\n    }\n  };\n});"
      },
